# Copy to livekit/vps/.env on the VPS.
# Use the SAME key + secret as the Railway huddle-livekit service (or update the
# huddle service's LIVEKIT_API_KEY / LIVEKIT_API_SECRET to match these).
LIVEKIT_API_KEY=huddle
LIVEKIT_API_SECRET=
# Hostname Caddy gets an HTTPS certificate for. No domain needed:
# use lk.<server-ip-with-dashes>.sslip.io, e.g. lk.203-0-113-7.sslip.io
LIVEKIT_HOST=
