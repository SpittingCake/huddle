# ── Huddle server ─────────────────────────────────────────────
# Copy to server/.env for local dev. On Railway, set these as Variables.

# Postgres connection string. On Railway: ${{huddle-postgres.DATABASE_URL}}
DATABASE_URL=postgres://huddle:huddle@localhost:5432/huddle

# Long random string used to sign login tokens. Changing it signs everyone out.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Public URL of this server (no trailing slash). Used for CORS and invite links.
SERVER_URL=http://localhost:3000

# Port to listen on. Railway sets PORT automatically.
PORT=3000

# First-boot owner account. Created once, only if the users table is empty.
# Remove these after the first successful login (they're ignored after that anyway).
OWNER_USERNAME=danny
OWNER_PASSWORD=change-me-10-chars-min
OWNER_DISPLAY_NAME=Danny

# Name of the server (the friend group). Created once on first boot.
SERVER_NAME=Huddle

# Set to "true" on Railway / behind any proxy so rate limits see real client IPs.
TRUST_PROXY=false

# ── Voice (LiveKit, batch 1+) ─────────────────────────────────
# Public WebSocket URL of the huddle-livekit service (wss://, no trailing slash).
# On Railway: wss://${{huddle-livekit.RAILWAY_PUBLIC_DOMAIN}}
LIVEKIT_URL=
# Must match the huddle-livekit service. On Railway reference them:
# ${{huddle-livekit.LIVEKIT_API_KEY}} / ${{huddle-livekit.LIVEKIT_API_SECRET}}
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: where the server calls LiveKit's HTTP API (listParticipants etc).
# Defaults to LIVEKIT_URL with ws→http. On Railway you can point this at the
# private network instead: http://huddle-livekit.railway.internal:7880
LIVEKIT_API_URL=

# ── Uploads (batch 3+) ────────────────────────────────────────
# Where attachments, avatars and the server icon are stored on disk.
# Local default: server/uploads. On Railway: add a Volume to the `huddle`
# service mounted at /data and set this to /data/uploads — otherwise files
# vanish on every redeploy.
UPLOAD_DIR=
# Per-file size cap for message attachments (avatars/icon are capped at 8).
MAX_UPLOAD_MB=25
